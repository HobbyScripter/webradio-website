# WebRadio Website — Environment Template
# Copy to `.env` and replace every placeholder. Never commit `.env`.
# `.env` is git-ignored; this file contains placeholders only.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Local development database from docker-compose.yml (port 5433) or a local
# PostgreSQL 18 installation. Create a NEW database; never point this at the
# legacy website.
DATABASE_URL="postgresql://postgres:CHANGE_ME@127.0.0.1:5433/webradio_dev"

# Integration tests use their own, disposable database whose name MUST end in
# `_test`. `npm run test:integration` refuses anything else.
TEST_DATABASE_URL="postgresql://postgres:CHANGE_ME@127.0.0.1:5433/webradio_test"

# ---------------------------------------------------------------------------
# NextAuth (required)
# ---------------------------------------------------------------------------
# 32 random bytes, base64url encoded:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NEXTAUTH_SECRET="REPLACE_WITH_A_RANDOM_32_BYTE_SECRET"
# Use https:// in production so the __Secure- cookies are issued.
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Public base URL (optional)
# ---------------------------------------------------------------------------
# Only set this when the site has a real public origin. It enables canonical
# URLs, Open Graph URLs and the sitemap; without it those tags are omitted.
NEXT_PUBLIC_SITE_URL=""

# ---------------------------------------------------------------------------
# One-time administrator bootstrap (CLI only, leave empty in normal operation)
# ---------------------------------------------------------------------------
# Only used by `npm run admin:bootstrap`. Remove after the first admin exists.
ADMIN_BOOTSTRAP_CONFIRM=""
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_NAME=""

# ---------------------------------------------------------------------------
# Optional services (safe to leave empty in development)
# ---------------------------------------------------------------------------
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET=""
STORAGE_REGION=""

EMAIL_FROM="noreply@webradio.local"
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_WEBHOOK_SECRET=""
