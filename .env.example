# WebRadio Website — Environment Template
# Copy to `.env` and replace every placeholder. Never commit `.env`.
# `.env` is git-ignored; this file contains placeholders only.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Two connection strings with different jobs (resolved centrally in
# `src/lib/db-connection.ts`):
#
#   DATABASE_URL_POOLED  application/serverless runtime  -> pooled.db.prisma.io
#   DIRECT_URL           DB commands of the Prisma CLI   -> db.prisma.io
#                        (db migrate, db verify, db schema, migration status,
#                         studio)
#
# Production (Vercel) requires DATABASE_URL_POOLED. DIRECT_URL is only needed by
# the DB commands above, never by `npm run build` or `prisma contract emit`
# (`prebuild` is offline). A missing or mismatched value for the command that
# needs it aborts with a clear message that names the variable and host, never
# the connection string. There is no silent fallback from the pooled runtime URL
# to a direct one.
DATABASE_URL_POOLED=""
DIRECT_URL=""

# Local development only: a loopback PostgreSQL (docker-compose.yml, port 5433)
# or a local PostgreSQL 18 installation. Create a NEW database; never point this
# at the legacy website. This fallback is accepted ONLY outside production and
# ONLY for loopback hosts (localhost, 127.0.0.1, ::1); `npm run db:migrate` and
# the Prisma CLI use it when DIRECT_URL is empty.
DATABASE_URL="postgresql://postgres:CHANGE_ME@127.0.0.1:5433/webradio_dev"

# Integration tests use their own, disposable database whose name MUST end in
# `_test`. `npm run test:integration` refuses anything else.
TEST_DATABASE_URL="postgresql://postgres:CHANGE_ME@127.0.0.1:5433/webradio_test"

# ---------------------------------------------------------------------------
# NextAuth (required)
# ---------------------------------------------------------------------------
# 32 random bytes, base64url encoded:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NEXTAUTH_SECRET="REPLACE_WITH_A_RANDOM_32_BYTE_SECRET"
# Production requires an HTTPS origin (loopback HTTP is allowed for local
# `next start` checks). It also drives password-reset/verification links.
NEXTAUTH_URL="http://localhost:3000"

# Trust the proxy's x-forwarded-for header for IP-based rate limits and audit
# IPs. Set to "1" only behind a proxy that overwrites the header. Vercel sets
# VERCEL=1 automatically, so this is not needed there. Without it, only
# account-based limits are applied and audit IPs are omitted.
TRUST_PROXY=""

# ---------------------------------------------------------------------------
# Public base URL (optional)
# ---------------------------------------------------------------------------
# Only set this when the site has a real public origin. It enables canonical
# URLs, Open Graph URLs and the sitemap; without it those tags are omitted.
NEXT_PUBLIC_SITE_URL=""

# ---------------------------------------------------------------------------
# One-time administrator bootstrap (CLI only, leave empty in normal operation)
# ---------------------------------------------------------------------------
# Only used by `npm run admin:bootstrap`. Remove after the first admin exists.
ADMIN_BOOTSTRAP_CONFIRM=""
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_NAME=""

# ---------------------------------------------------------------------------
# SYSTEM_ADMIN bootstrap / recovery (CLI only)
# ---------------------------------------------------------------------------
# Used only by `npm run system-admin:bootstrap` and
# `npm run system-admin:recover`. Never set these on Vercel or on a running
# server, and never commit real values. SYSTEM_ADMIN cannot be requested over
# HTTP. See README.md for the exact commands.
SYSTEM_ADMIN_BOOTSTRAP_CONFIRM=""
SYSTEM_ADMIN_EMAIL=""
SYSTEM_ADMIN_PASSWORD=""
SYSTEM_ADMIN_NAME=""
SYSTEM_ADMIN_TARGET_ID=""
SYSTEM_ADMIN_TARGET_EMAIL=""
SYSTEM_ADMIN_RECOVERY=""
SYSTEM_ADMIN_RECOVERY_CONFIRM=""

# ---------------------------------------------------------------------------
# Optional services (safe to leave empty in development)
# ---------------------------------------------------------------------------
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET=""
STORAGE_REGION=""

# Transactional e-mail (password reset, address verification).
#
# Provider order: Resend HTTPS API → SMTP → local outbox (development only).
# A set RESEND_API_KEY is authoritative: without EMAIL_FROM the send fails with
# `invalid_config` instead of silently falling back to SMTP or the outbox.
# Development/test without any provider writes to .local-db/outbox/ (0600)
# instead of logging a token. Production without a provider returns the generic
# response but cannot deliver mail — see docs/EMAIL_SETUP.md.
#
# EMAIL_DELIVERY_ENABLED is the operator switch. Delivery is PAUSED unless it
# is exactly "true": no provider call, no outbox write, no fake success. Keep it
# unset/false while the sender domain is not verified or mail is paused.
EMAIL_DELIVERY_ENABLED="false"
# EMAIL_FROM must be an address on a domain verified at the provider.
EMAIL_FROM="noreply@webradio.local"
RESEND_API_KEY=""
# SMTP alternative (kept for self-hosting); ignored while RESEND_API_KEY is set.
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_WEBHOOK_SECRET=""

# Optional server-side token for the public GitHub REST API. Raises the
# unauthenticated rate limit; it is never exposed to the browser and must not
# be prefixed with NEXT_PUBLIC_. Keep it empty if the public limit is enough.
GITHUB_TOKEN=""

# Legal pages (/impressum, /datenschutz, /nutzungsbedingungen).
#
# The pages are permanent parts of the site: always routed, always linked from
# the footer, reachable without a login, and never enabled or disabled by
# configuration.
#
# The values below are operator facts, not an activation switch. While a
# required value is missing, the page renders a notice listing the missing
# facts instead of an invented placeholder and stays out of search indexes.
# Once every required value is present, the texts are rendered.
# These are operator facts, not secrets. Never invent values.
LEGAL_OPERATOR_NAME=""
LEGAL_OPERATOR_STREET=""
LEGAL_OPERATOR_POSTAL_CODE=""
LEGAL_OPERATOR_CITY=""
LEGAL_OPERATOR_COUNTRY=""
LEGAL_OPERATOR_EMAIL=""
LEGAL_OPERATOR_PHONE=""
LEGAL_OPERATOR_REPRESENTED_BY=""
LEGAL_OPERATOR_REGISTER_COURT=""
LEGAL_OPERATOR_REGISTER_NUMBER=""
LEGAL_OPERATOR_VAT_ID=""
LEGAL_OPERATOR_CONTENT_RESPONSIBLE=""
LEGAL_HOSTING_PROVIDER=""
LEGAL_HOSTING_REGION=""
LEGAL_DATABASE_PROVIDER=""
LEGAL_DATABASE_REGION=""
LEGAL_MAIL_PROVIDER=""
LEGAL_RETENTION_SESSIONS=""
LEGAL_RETENTION_AUDIT_LOGS=""
LEGAL_RETENTION_RATE_LIMITS=""
LEGAL_SUPERVISORY_AUTHORITY=""
