// use prisma-8
// WebRadio Website - Database Contract
// Prisma ORM 8 format (contract.prisma)

// User role enum for Role-Based Access Control (RBAC)
enum Role {
  USER
  DEVELOPER
  ADMIN
  // Highest regular level. Only the audited CLI bootstrap/recovery path may
  // assign it; no HTTP endpoint or registration field can request it.
  SYSTEM_ADMIN
}

// Account state. `SUSPENDED` with `suspendedUntil = null` is permanent;
// with a timestamp it ends at that instant. The effective state is derived on
// every request (see src/lib/roles.ts) — expiry is never written back, so a
// stale timestamp can not lift a permanently recorded suspension.
enum UserStatus {
  ACTIVE
  SUSPENDED
}

// User model - Core authentication entity
model User {
  id               String             @id @onCreate(uuid(7))
  email            String             @unique
  passwordHash     String
  name             String?
  role             Role               @default(USER)
  emailVerified    DateTime?
  status           UserStatus         @default(ACTIVE)
  suspendedAt      DateTime?
  suspendedUntil   DateTime?
  suspendedReason  String?
  suspendedById    String?
  createdAt        DateTime           @onCreate(now())
  updatedAt        DateTime           @onCreate(now()) @onUpdate(now())

  sessions         Session[]
  authTokens       AuthToken[]
  developerProfile DeveloperProfile?
  auditLogs        AuditLog[]
  reviews          PublicationReview[]
  suspendedBy      User?                  @relation("UserSuspensions", fields: [suspendedById], references: [id], onDelete: SetNull)
  suspensionsIssued User[]                @relation("UserSuspensions")
  developerApplications DeveloperApplication[] @relation("DeveloperApplicationApplicant")
  reportsFiled     ContentReport[]        @relation("ReportReporter")
  reportsResolved  ContentReport[]        @relation("ReportResolver")
  applicationDecisions DeveloperApplication[] @relation("DeveloperApplicationDecisions")

  @@index([email])
  @@index([role])
  @@index([status])
}

// Session model for server-side authentication & revocation
model Session {
  id           String   @id @onCreate(uuid(7))
  userId       String
  token        String   @unique
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @onCreate(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

// One-time, hashed tokens for e-mail verification and password resets.
// Only the SHA-256 hash is stored; the raw token is returned to the caller once
// and never persisted. `usedAt` makes every token single-use.
enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model AuthToken {
  id        String        @id @onCreate(uuid(7))
  userId    String
  tokenHash String        @unique
  type      AuthTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @onCreate(now())

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

// Server-side rate limiting. Every instance shares this table, so the limit
// also holds on Vercel's serverless functions. `key` is a SHA-256 digest of
// scope + normalized identifier + fixed window; no e-mail address or IP is
// stored in clear text. Expired rows can be removed by a periodic job.
model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime
  expiresAt   DateTime

  @@index([expiresAt])
}

// Developer profile for plugin/theme authors
model DeveloperProfile {
  id          String   @id @onCreate(uuid(7))
  userId      String   @unique
  displayName String
  bio         String?
  githubUrl   String?
  websiteUrl  String?
  createdAt   DateTime @onCreate(now())
  updatedAt   DateTime @onCreate(now()) @onUpdate(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plugins     Plugin[]
  themes      Theme[]

  @@index([userId])
}

// Developer access request. A normal registration never creates this row and
// never grants DEVELOPER; only an administrator decision does. `PENDING` is
// unique per user (enforced transactionally in the service layer).
enum DeveloperApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

model DeveloperApplication {
  id            String                     @id @onCreate(uuid(7))
  userId        String
  motivation    String
  portfolioUrl  String?
  status        DeveloperApplicationStatus @default(PENDING)
  decisionNotes String?
  decidedById   String?
  decidedAt     DateTime?
  createdAt     DateTime                   @onCreate(now())
  updatedAt     DateTime                   @onCreate(now()) @onUpdate(now())

  user      User  @relation("DeveloperApplicationApplicant", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User? @relation("DeveloperApplicationDecisions", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, status])
  @@index([status])
  @@index([createdAt])
}

// Every catalogue entry is bound to the WebRadio desktop program. The enum
// deliberately has one value: offering arbitrary software would require a
// reviewed contract migration, not just a different request body.
enum Product {
  WEBRADIO
}

// Plugin model
model Plugin {
  id          String       @id @onCreate(uuid(7))
  slug        String       @unique
  name        String
  description String
  // Canonical https://github.com/OWNER/REPOSITORY link, optional. Used to
  // prefill the release lookup when a new version is added; the release data
  // itself is never stored automatically.
  repositoryUrl String?
  product     Product      @default(WEBRADIO)
  developerId String
  status      PluginStatus @default(PENDING_REVIEW)
  isPublished Boolean      @default(false)
  downloads   Int          @default(0)
  createdAt   DateTime     @onCreate(now())
  updatedAt   DateTime     @onCreate(now()) @onUpdate(now())

  developer   DeveloperProfile   @relation(fields: [developerId], references: [id], onDelete: Cascade)
  versions    PluginVersion[]
  screenshots PluginScreenshot[]
  tags        PluginTag[]

  @@index([slug])
  @@index([developerId])
  @@index([status])
  @@index([isPublished])
  @@index([product])
}

enum PluginStatus {
  // Persisted draft: only the owner sees it, never a moderator or the public.
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  // Reviewer asked the developer for changes; editable and resubmittable.
  CHANGES_REQUESTED
  ARCHIVED
  // Administratively taken down. Terminal: never resubmittable by the owner.
  REMOVED
}

// Plugin version
model PluginVersion {
  id                 String   @id @onCreate(uuid(7))
  pluginId           String
  version            String
  description        String?
  fileUrl            String
  fileSize           Int
  checksum           String
  minWebradioVersion String?
  maxWebradioVersion String?
  releasedAt         DateTime @onCreate(now())
  isLatest           Boolean  @default(false)

  plugin             Plugin   @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  @@unique([pluginId, version])
  @@index([pluginId])
  @@index([isLatest])
}

// Plugin screenshot
model PluginScreenshot {
  id        String   @id @onCreate(uuid(7))
  pluginId  String
  url       String
  caption   String?
  order     Int
  createdAt DateTime @onCreate(now())

  plugin    Plugin   @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  @@index([pluginId])
}

// Plugin tag
model PluginTag {
  id       String @id @onCreate(uuid(7))
  pluginId String
  tag      String

  plugin   Plugin @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  @@unique([pluginId, tag])
  @@index([tag])
}

// Theme model
model Theme {
  id          String      @id @onCreate(uuid(7))
  slug        String      @unique
  name        String
  description String
  product     Product     @default(WEBRADIO)
  developerId String
  status      ThemeStatus @default(PENDING_REVIEW)
  isPublished Boolean     @default(false)
  downloads   Int         @default(0)
  createdAt   DateTime    @onCreate(now())
  updatedAt   DateTime    @onCreate(now()) @onUpdate(now())

  developer   DeveloperProfile  @relation(fields: [developerId], references: [id], onDelete: Cascade)
  versions    ThemeVersion[]
  screenshots ThemeScreenshot[]
  tags        ThemeTag[]

  @@index([slug])
  @@index([developerId])
  @@index([status])
  @@index([isPublished])
  @@index([product])
}

enum ThemeStatus {
  // Persisted draft: only the owner sees it, never a moderator or the public.
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  // Reviewer asked the developer for changes; editable and resubmittable.
  CHANGES_REQUESTED
  ARCHIVED
  // Administratively taken down. Terminal: never resubmittable by the owner.
  REMOVED
}

// Theme version
model ThemeVersion {
  id                 String   @id @onCreate(uuid(7))
  themeId            String
  version            String
  description        String?
  fileUrl            String
  fileSize           Int
  checksum           String
  minWebradioVersion String?
  maxWebradioVersion String?
  releasedAt         DateTime @onCreate(now())
  isLatest           Boolean  @default(false)

  theme              Theme    @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@unique([themeId, version])
  @@index([themeId])
  @@index([isLatest])
}

// Theme screenshot
model ThemeScreenshot {
  id        String   @id @onCreate(uuid(7))
  themeId   String
  url       String
  caption   String?
  order     Int
  createdAt DateTime @onCreate(now())

  theme     Theme    @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@index([themeId])
}

// Theme tag
model ThemeTag {
  id      String @id @onCreate(uuid(7))
  themeId String
  tag     String

  theme   Theme  @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@unique([themeId, tag])
  @@index([tag])
}

// Publication Review for Plugins & Themes (Approval workflow)
enum ReviewTarget {
  PLUGIN
  THEME
}

enum ReviewResult {
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  // Administrative takedown of already published content (not a review
  // decision). Kept in this table so the moderation history stays complete.
  REMOVED
}

model PublicationReview {
  id         String       @id @onCreate(uuid(7))
  targetType ReviewTarget
  targetId   String
  reviewerId String
  status     ReviewResult
  notes      String?
  createdAt  DateTime     @onCreate(now())

  reviewer   User         @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@index([reviewerId])
  @@index([createdAt])
}

// User-submitted abuse report. A report is a pointer, never a verdict: it does
// nothing until an administrator decides. The unique key stops the same user
// from reporting the same target twice (a repeat answers 409).
enum ReportTargetType {
  PLUGIN
  THEME
  PLUGIN_VERSION
  THEME_VERSION
}

enum ReportReason {
  ILLEGAL
  MALWARE
  COPYRIGHT
  SPAM
  MISLEADING
  OTHER
}

enum ContentReportStatus {
  OPEN
  DISMISSED
  CONTENT_REMOVED
  WARNING_ISSUED
  ACCOUNT_SUSPENDED
}

model ContentReport {
  id              String             @id @onCreate(uuid(7))
  reporterId      String
  targetType      ReportTargetType
  targetId        String
  reason          ReportReason
  details         String?
  status          ContentReportStatus @default(OPEN)
  resolutionNotes String?
  resolvedById    String?
  resolvedAt      DateTime?
  createdAt       DateTime           @onCreate(now())
  updatedAt       DateTime           @onCreate(now()) @onUpdate(now())

  reporter   User  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([reporterId, targetType, targetId])
  @@index([status])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// Release model
model Release {
  id          String      @id @onCreate(uuid(7))
  version     String      @unique
  title       String
  description String
  product     Product     @default(WEBRADIO)
  releaseDate DateTime    @onCreate(now())
  isLatest    Boolean     @default(false)
  downloadUrl String?
  fileSize    Int?
  checksum    String?

  changelogs  Changelog[]

  @@index([version])
  @@index([releaseDate])
  @@index([product])
}

// Changelog entry
model Changelog {
  id        String   @id @onCreate(uuid(7))
  releaseId String
  category  String
  text      String
  createdAt DateTime @onCreate(now())

  release   Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@index([releaseId])
}

// News article
model News {
  id          String    @id @onCreate(uuid(7))
  slug        String    @unique
  title       String
  content     String
  summary     String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @onCreate(now())
  updatedAt   DateTime  @onCreate(now()) @onUpdate(now())

  @@index([slug])
  @@index([isPublished])
  @@index([publishedAt])
}

// Roadmap item
model RoadmapItem {
  id          String        @id @onCreate(uuid(7))
  title       String
  description String
  status      RoadmapStatus @default(PLANNED)
  priority    Int           @default(0)
  targetDate  DateTime?
  completedAt DateTime?
  createdAt   DateTime      @onCreate(now())
  updatedAt   DateTime      @onCreate(now()) @onUpdate(now())

  @@index([status])
  @@index([priority])
}

enum RoadmapStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Audit log for security and compliance
model AuditLog {
  id        String   @id @onCreate(uuid(7))
  userId    String?
  action    String
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @onCreate(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// GitHub integration tokens (stored encrypted)
model GitHubToken {
  id        String    @id @onCreate(uuid(7))
  userId    String    @unique
  token     String
  scopes    String[]
  expiresAt DateTime?
  createdAt DateTime  @onCreate(now())
  updatedAt DateTime  @onCreate(now()) @onUpdate(now())

  @@index([userId])
}
