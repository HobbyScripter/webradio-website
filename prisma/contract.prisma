// use prisma-8
// WebRadio Website - Database Contract
// Prisma ORM 8 format (contract.prisma)

// User role enum for Role-Based Access Control (RBAC)
enum Role {
  USER
  DEVELOPER
  ADMIN
  // Highest regular level. Only the audited CLI bootstrap/recovery path may
  // assign it; no HTTP endpoint or registration field can request it.
  SYSTEM_ADMIN
}

// Account state. `SUSPENDED` with `suspendedUntil = null` is permanent;
// with a timestamp it ends at that instant. The effective state is derived on
// every request (see src/lib/roles.ts) — expiry is never written back, so a
// stale timestamp can not lift a permanently recorded suspension.
enum UserStatus {
  ACTIVE
  SUSPENDED
}

// User model - Core authentication entity
model User {
  id               String             @id @onCreate(uuid(7))
  email            String             @unique
  passwordHash     String
  name             String?
  role             Role               @default(USER)
  emailVerified    DateTime?
  // Preferred interface language (BCP-47 primary subtag: de, en, nl, fr, es, it, pl).
  // Null means "not chosen yet" so detection can fall through to the cookie and
  // the browser instead of forcing German onto a new account.
  locale           String?
  status           UserStatus         @default(ACTIVE)
  suspendedAt      DateTime?
  suspendedUntil   DateTime?
  suspendedReason  String?
  suspendedById    String?
  createdAt        DateTime           @onCreate(now())
  updatedAt        DateTime           @onCreate(now()) @onUpdate(now())

  sessions         Session[]
  authTokens       AuthToken[]
  developerProfile DeveloperProfile?
  auditLogs        AuditLog[]
  reviews          PublicationReview[]
  suspendedBy      User?                  @relation("UserSuspensions", fields: [suspendedById], references: [id], onDelete: SetNull)
  suspensionsIssued User[]                @relation("UserSuspensions")
  developerApplications DeveloperApplication[] @relation("DeveloperApplicationApplicant")
  reportsFiled     ContentReport[]        @relation("ReportReporter")
  reportsResolved  ContentReport[]        @relation("ReportResolver")
  applicationDecisions DeveloperApplication[] @relation("DeveloperApplicationDecisions")

  @@index([email])
  @@index([role])
  @@index([status])
}

// Translations of stored content (plugins, themes, partners, advertising, …).
//
// Normalised on purpose: one row per (entity, locale, field) instead of a
// column per language. Adding a language therefore inserts rows, never a
// schema change, and the original value stays in its own column on the entity —
// nothing is overwritten and a missing translation simply falls back.
//
// `status` gates publication: only APPROVED rows are served publicly, so a
// draft or a review copy can never leak to visitors.
//
// Statuses (enforced in the service layer):
//   MISSING            — a job exists, no value yet
//   MACHINE_TRANSLATED — produced by a provider, **never** treated as reviewed
//   REVIEW_REQUIRED    — machine output that needs human review (legal, names)
//   APPROVED           — explicitly released by an administrator
//   REJECTED           — reviewed and refused; not served
//
// `sourceHash` records the German source the value was produced from. If the
// source changes, the hash no longer matches and the row is outdated: it is not
// served and is offered for re-translation instead of being overwritten.
model ContentTranslation {
  id             String   @id @onCreate(uuid(7))
  // Entity name as written in the contract, e.g. "Plugin" or "AdCampaign".
  entityType     String
  entityId       String
  locale         String
  // Field of the entity, e.g. "name" or "description".
  field          String
  value          String   @default("")
  // MISSING | MACHINE_TRANSLATED | REVIEW_REQUIRED | APPROVED | REJECTED.
  status         String   @default("MISSING")
  // Provider that produced the current value ("deepl"), null for human edits.
  provider       String?
  // SHA-256 of the source text this value was translated from.
  sourceHash     String?
  // Set when the source changed after translating; outdated rows are not served.
  outdated       Boolean  @default(false)
  translatedById String?
  reviewedAt     DateTime?
  createdAt      DateTime @onCreate(now())
  updatedAt      DateTime @onCreate(now()) @onUpdate(now())

  @@unique([entityType, entityId, locale, field])
  @@index([entityType, entityId])
  @@index([locale])
  @@index([status])
  @@index([outdated])
}

// Idempotent unit of machine translation work.
//
// `jobKey` is a hash over (entity, locale, field, sourceHash). The unique index
// is what makes a job idempotent: a second request for the same source text and
// target reuses the finished job instead of paying for the same API call twice.
// The row is also the persistent queue — a job stays PENDING until a worker
// (admin action, cron endpoint) claims it.
model TranslationJob {
  id            String    @id @onCreate(uuid(7))
  jobKey        String    @unique
  entityType    String
  entityId      String
  locale        String
  field         String
  provider      String
  // PENDING | RUNNING | SUCCEEDED | FAILED | SKIPPED
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  // Stable, secret-free error code (e.g. RATE_LIMITED, QUOTA_EXCEEDED).
  errorCode     String?
  sourceHash    String
  characters    Int       @default(0)
  requestedById String?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime  @onCreate(now())
  updatedAt     DateTime  @onCreate(now()) @onUpdate(now())

  @@index([status])
  @@index([locale])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// Append-only history of every translation decision.
//
// Nothing here is ever updated or deleted: who changed which translation from
// which status to which status, with which provider, and when. Machine output
// and human approval stay distinguishable forever.
model TranslationEvent {
  id            String   @id @onCreate(uuid(7))
  // Null when the event concerns a field that has no row yet (blocked, failed).
  translationId String?
  entityType    String
  entityId      String
  locale        String
  field         String
  // MACHINE_TRANSLATED | EDITED | APPROVED | REJECTED | RETRANSLATED |
  // MARKED_OUTDATED | BLOCKED | FAILED
  action        String
  fromStatus    String?
  toStatus      String?
  provider      String?
  actorId       String?
  // Short, non-sensitive explanation (error code, reason).
  note          String?
  createdAt     DateTime @onCreate(now())

  @@index([entityType, entityId, locale, field])
  @@index([createdAt])
  @@index([action])
}

// Provider consumption and cost, one row per accepted API call.
//
// `costMicros` is stored at write time (characters × configured price), so a
// later price change never rewrites the history of what was actually spent.
model TranslationUsage {
  id         String   @id @onCreate(uuid(7))
  provider   String
  // Target locale of the call, null for account-level readings.
  locale     String?
  characters Int      @default(0)
  requests   Int      @default(1)
  costMicros Int      @default(0)
  // Provider-reported monthly quota, when the provider exposes it.
  quotaUsed  Int?
  quotaLimit Int?
  createdAt  DateTime @onCreate(now())

  @@index([provider, createdAt])
  @@index([locale])
}

// Session model for server-side authentication & revocation
model Session {
  id           String   @id @onCreate(uuid(7))
  userId       String
  token        String   @unique
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @onCreate(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

// One-time, hashed tokens for e-mail verification and password resets.
// Only the SHA-256 hash is stored; the raw token is returned to the caller once
// and never persisted. `usedAt` makes every token single-use.
enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model AuthToken {
  id        String        @id @onCreate(uuid(7))
  userId    String
  tokenHash String        @unique
  type      AuthTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @onCreate(now())

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

// Server-side rate limiting. Every instance shares this table, so the limit
// also holds on Vercel's serverless functions. `key` is a SHA-256 digest of
// scope + normalized identifier + fixed window; no e-mail address or IP is
// stored in clear text. Expired rows can be removed by a periodic job.
model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime
  expiresAt   DateTime

  @@index([expiresAt])
}

// Developer profile for plugin/theme authors
model DeveloperProfile {
  id          String   @id @onCreate(uuid(7))
  userId      String   @unique
  displayName String
  bio         String?
  githubUrl   String?
  websiteUrl  String?
  createdAt   DateTime @onCreate(now())
  updatedAt   DateTime @onCreate(now()) @onUpdate(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plugins     Plugin[]
  themes      Theme[]

  @@index([userId])
}

// Developer access request. A normal registration never creates this row and
// never grants DEVELOPER; only an administrator decision does. `PENDING` is
// unique per user (enforced transactionally in the service layer).
enum DeveloperApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

model DeveloperApplication {
  id            String                     @id @onCreate(uuid(7))
  userId        String
  motivation    String
  portfolioUrl  String?
  status        DeveloperApplicationStatus @default(PENDING)
  decisionNotes String?
  decidedById   String?
  decidedAt     DateTime?
  createdAt     DateTime                   @onCreate(now())
  updatedAt     DateTime                   @onCreate(now()) @onUpdate(now())

  user      User  @relation("DeveloperApplicationApplicant", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User? @relation("DeveloperApplicationDecisions", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, status])
  @@index([status])
  @@index([createdAt])
}

// Every catalogue entry is bound to the WebRadio desktop program. The enum
// deliberately has one value: offering arbitrary software would require a
// reviewed contract migration, not just a different request body.
enum Product {
  WEBRADIO
}

// Plugin model
model Plugin {
  id          String       @id @onCreate(uuid(7))
  slug        String       @unique
  name        String
  description String
  // Canonical https://github.com/OWNER/REPOSITORY link, optional. Used to
  // prefill the release lookup when a new version is added; the release data
  // itself is never stored automatically.
  repositoryUrl String?
  product     Product      @default(WEBRADIO)
  developerId String
  status      PluginStatus @default(PENDING_REVIEW)
  isPublished Boolean      @default(false)
  downloads   Int          @default(0)
  createdAt   DateTime     @onCreate(now())
  updatedAt   DateTime     @onCreate(now()) @onUpdate(now())

  developer   DeveloperProfile   @relation(fields: [developerId], references: [id], onDelete: Cascade)
  versions    PluginVersion[]
  screenshots PluginScreenshot[]
  tags        PluginTag[]

  @@index([slug])
  @@index([developerId])
  @@index([status])
  @@index([isPublished])
  @@index([product])
}

enum PluginStatus {
  // Persisted draft: only the owner sees it, never a moderator or the public.
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  // Reviewer asked the developer for changes; editable and resubmittable.
  CHANGES_REQUESTED
  ARCHIVED
  // Administratively taken down. Terminal: never resubmittable by the owner.
  REMOVED
}

// Plugin version
model PluginVersion {
  id                 String                   @id @onCreate(uuid(7))
  pluginId           String
  version            String
  description        String?
  fileUrl            String
  fileSize           Int
  checksum           String
  minWebradioVersion String?
  maxWebradioVersion String?
  releasedAt         DateTime                 @onCreate(now())
  isLatest           Boolean                  @default(false)

  plugin             Plugin   @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  @@unique([pluginId, version])
  @@index([pluginId])
  @@index([isLatest])
}

// Plugin screenshot
model PluginScreenshot {
  id        String   @id @onCreate(uuid(7))
  pluginId  String
  url       String
  caption   String?
  order     Int
  createdAt DateTime @onCreate(now())

  plugin    Plugin   @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  @@index([pluginId])
}

// Plugin tag
model PluginTag {
  id       String @id @onCreate(uuid(7))
  pluginId String
  tag      String

  plugin   Plugin @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  @@unique([pluginId, tag])
  @@index([tag])
}

// Theme model
model Theme {
  id          String      @id @onCreate(uuid(7))
  slug        String      @unique
  name        String
  description String
  product     Product     @default(WEBRADIO)
  developerId String
  status      ThemeStatus @default(PENDING_REVIEW)
  isPublished Boolean     @default(false)
  downloads   Int         @default(0)
  createdAt   DateTime    @onCreate(now())
  updatedAt   DateTime    @onCreate(now()) @onUpdate(now())

  developer   DeveloperProfile  @relation(fields: [developerId], references: [id], onDelete: Cascade)
  versions    ThemeVersion[]
  screenshots ThemeScreenshot[]
  tags        ThemeTag[]

  @@index([slug])
  @@index([developerId])
  @@index([status])
  @@index([isPublished])
  @@index([product])
}

enum ThemeStatus {
  // Persisted draft: only the owner sees it, never a moderator or the public.
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  // Reviewer asked the developer for changes; editable and resubmittable.
  CHANGES_REQUESTED
  ARCHIVED
  // Administratively taken down. Terminal: never resubmittable by the owner.
  REMOVED
}

// Theme version
model ThemeVersion {
  id                 String                   @id @onCreate(uuid(7))
  themeId            String
  version            String
  description        String?
  fileUrl            String
  fileSize           Int
  checksum           String
  minWebradioVersion String?
  maxWebradioVersion String?
  releasedAt         DateTime                 @onCreate(now())
  isLatest           Boolean                  @default(false)

  theme              Theme    @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@unique([themeId, version])
  @@index([themeId])
  @@index([isLatest])
}

// Theme screenshot
model ThemeScreenshot {
  id        String   @id @onCreate(uuid(7))
  themeId   String
  url       String
  caption   String?
  order     Int
  createdAt DateTime @onCreate(now())

  theme     Theme    @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@index([themeId])
}

// Theme tag
model ThemeTag {
  id      String @id @onCreate(uuid(7))
  themeId String
  tag     String

  theme   Theme  @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@unique([themeId, tag])
  @@index([tag])
}

// Publication Review for Plugins & Themes (Approval workflow)
enum ReviewTarget {
  PLUGIN
  THEME
}

enum ReviewResult {
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  // Administrative takedown of already published content (not a review
  // decision). Kept in this table so the moderation history stays complete.
  REMOVED
}

model PublicationReview {
  id         String       @id @onCreate(uuid(7))
  targetType ReviewTarget
  targetId   String
  reviewerId String
  status     ReviewResult
  notes      String?
  createdAt  DateTime     @onCreate(now())

  reviewer   User         @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@index([reviewerId])
  @@index([createdAt])
}

// User-submitted abuse report. A report is a pointer, never a verdict: it does
// nothing until an administrator decides. The unique key stops the same user
// from reporting the same target twice (a repeat answers 409).
enum ReportTargetType {
  PLUGIN
  THEME
  PLUGIN_VERSION
  THEME_VERSION
}

enum ReportReason {
  ILLEGAL
  MALWARE
  COPYRIGHT
  SPAM
  MISLEADING
  OTHER
}

enum ContentReportStatus {
  OPEN
  DISMISSED
  CONTENT_REMOVED
  WARNING_ISSUED
  ACCOUNT_SUSPENDED
}

model ContentReport {
  id              String             @id @onCreate(uuid(7))
  reporterId      String
  targetType      ReportTargetType
  targetId        String
  reason          ReportReason
  details         String?
  status          ContentReportStatus @default(OPEN)
  resolutionNotes String?
  resolvedById    String?
  resolvedAt      DateTime?
  createdAt       DateTime           @onCreate(now())
  updatedAt       DateTime           @onCreate(now()) @onUpdate(now())

  reporter   User  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([reporterId, targetType, targetId])
  @@index([status])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// Release model
model Release {
  id          String      @id @onCreate(uuid(7))
  version     String      @unique
  title       String
  description String
  product     Product     @default(WEBRADIO)
  releaseDate DateTime    @onCreate(now())
  isLatest    Boolean     @default(false)
  downloadUrl String?
  fileSize    Int?
  checksum    String?

  changelogs  Changelog[]

  @@index([version])
  @@index([releaseDate])
  @@index([product])
}

// Changelog entry
model Changelog {
  id        String   @id @onCreate(uuid(7))
  releaseId String
  category  String
  text      String
  createdAt DateTime @onCreate(now())

  release   Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@index([releaseId])
}

// News article
model News {
  id          String    @id @onCreate(uuid(7))
  slug        String    @unique
  title       String
  content     String
  summary     String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @onCreate(now())
  updatedAt   DateTime  @onCreate(now()) @onUpdate(now())

  @@index([slug])
  @@index([isPublished])
  @@index([publishedAt])
}

// Roadmap item
model RoadmapItem {
  id          String        @id @onCreate(uuid(7))
  title       String
  description String
  status      RoadmapStatus @default(PLANNED)
  priority    Int           @default(0)
  targetDate  DateTime?
  completedAt DateTime?
  createdAt   DateTime      @onCreate(now())
  updatedAt   DateTime      @onCreate(now()) @onUpdate(now())

  @@index([status])
  @@index([priority])
}

enum RoadmapStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Audit log for security and compliance
model AuditLog {
  id        String   @id @onCreate(uuid(7))
  userId    String?
  action    String
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @onCreate(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// GitHub integration tokens (stored encrypted)
model GitHubToken {
  id        String    @id @onCreate(uuid(7))
  userId    String    @unique
  token     String
  scopes    String[]
  expiresAt DateTime?
  createdAt DateTime  @onCreate(now())
  updatedAt DateTime  @onCreate(now()) @onUpdate(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Legal documents (central management, versioned)
// ---------------------------------------------------------------------------

enum LegalDocumentType {
  IMPRESSUM
  DATENSCHUTZ
  NUTZUNGSBEDINGUNGEN
}

enum LegalDocumentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// Each row is one version of a legal document. Drafts and published versions
// share this table so the full history stays available.
model LegalDocument {
  id                String               @id @onCreate(uuid(7))
  type              LegalDocumentType
  versionNumber     Int
  title             String?
  content           String
  changeDescription String?
  status            LegalDocumentStatus  @default(DRAFT)
  requiresConsent   Boolean              @default(false)
  createdBy         String?
  publishedBy       String?
  createdAt         DateTime             @onCreate(now())
  updatedAt         DateTime             @onCreate(now()) @onUpdate(now())
  publishedAt       DateTime?

  @@unique([type, versionNumber])
  @@index([type, status])
  @@index([type, createdAt])
  @@index([type, publishedAt])
}

// Recorded consent of a user to a specific version of a legal document (used
// for the terms of use). Never overwritten or deleted.
model LegalConsent {
  id                  String            @id @onCreate(uuid(7))
  userId              String
  documentType        LegalDocumentType
  documentVersionId   String
  acceptedAt          DateTime          @onCreate(now())
  ipAddress           String?
  userAgent           String?

  @@index([userId, documentType])
  @@index([documentVersionId])
  @@index([acceptedAt])
}

// Technical marker for changes that may affect the privacy policy. This does
// not change any legal text automatically.
model PrivacyImpactNote {
  id          String    @id @onCreate(uuid(7))
  area        String
  description String
  markedById  String?
  createdAt   DateTime  @onCreate(now())
  resolvedAt  DateTime?
  resolvedById String?

  @@index([createdAt])
  @@index([resolvedAt])
}

// ---------------------------------------------------------------------------
// GitHub App Integration & Webhooks
// ---------------------------------------------------------------------------

enum GitHubInstallationStatus {
  CONNECTED
  SUSPENDED
  DELETED
}

model GitHubAppInstallation {
  id               String                   @id @onCreate(uuid(7))
  installationId   BigInt                   @unique
  appId            BigInt?
  appName          String?
  accountLogin     String
  repositoryName   String
  status           GitHubInstallationStatus @default(CONNECTED)
  permissions      String?
  lastApiCallAt    DateTime?
  lastWebhookAt    DateTime?
  createdAt        DateTime                 @onCreate(now())
  updatedAt        DateTime                 @onCreate(now()) @onUpdate(now())

  @@index([installationId])
  @@index([repositoryName])
}

model GitHubWebhookDelivery {
  id          String   @id @onCreate(uuid(7))
  deliveryId  String   @unique
  event       String
  action      String?
  repository  String?
  processedAt DateTime @onCreate(now())

  @@index([deliveryId])
  @@index([event])
}

// ---------------------------------------------------------------------------
// Download Analytics & Statistics
// ---------------------------------------------------------------------------

enum DownloadSyncStatus {
  RUNNING
  SUCCESS
  FAILED
}

model GitHubReleaseAsset {
  id                   String                   @id @onCreate(uuid(7))
  githubAssetId        BigInt                   @unique
  releaseId            BigInt
  releaseTag           String
  releaseChannel       String
  fileName             String
  platform             String?
  format               String?
  contentType          String?
  state                String?
  digest               String?
  releaseName          String?
  releasePublishedAt   DateTime?
  isPrerelease         Boolean                  @default(false)
  size                 BigInt
  downloadUrl          String
  currentDownloadCount Int                      @default(0)
  lastSyncedAt         DateTime                 @onCreate(now())
  createdAt            DateTime                 @onCreate(now())
  updatedAt            DateTime                 @onCreate(now()) @onUpdate(now())

  snapshots            GitHubDownloadSnapshot[]
  websiteStats         WebsiteDownloadStat[]

  @@index([githubAssetId])
  @@index([releaseTag])
  @@index([releaseChannel])
}

model GitHubDownloadSnapshot {
  id            String             @id @onCreate(uuid(7))
  assetId       String
  downloadCount Int
  snapshotDate  DateTime
  createdAt     DateTime           @onCreate(now())

  asset         GitHubReleaseAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, snapshotDate])
  @@index([snapshotDate])
}

model WebsiteDownloadStat {
  id          String             @id @onCreate(uuid(7))
  assetId     String
  countryCode String
  date        DateTime
  count       Int                @default(1)
  createdAt   DateTime           @onCreate(now())
  updatedAt   DateTime           @onCreate(now()) @onUpdate(now())

  asset       GitHubReleaseAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, countryCode, date])
  @@index([date])
  @@index([countryCode])
}

// ---------------------------------------------------------------------------
// Repository Traffic Analytics
// GitHub only exposes 14 days of traffic; daily values are archived here.
// ---------------------------------------------------------------------------

model GitHubTrafficDaily {
  id             String   @id @onCreate(uuid(7))
  day            DateTime
  views          Int      @default(0)
  uniqueVisitors Int      @default(0)
  clones         Int      @default(0)
  uniqueClones   Int      @default(0)
  capturedAt     DateTime @onCreate(now())
  updatedAt      DateTime @onCreate(now()) @onUpdate(now())

  @@unique([day])
}

model GitHubTrafficReferrerSnapshot {
  id          String   @id @onCreate(uuid(7))
  capturedFor DateTime
  referrer    String
  count       Int      @default(0)
  uniques     Int      @default(0)
  createdAt   DateTime @onCreate(now())

  @@unique([capturedFor, referrer])
}

model GitHubTrafficPathSnapshot {
  id          String   @id @onCreate(uuid(7))
  capturedFor DateTime
  path        String
  title       String?
  count       Int      @default(0)
  uniques     Int      @default(0)
  createdAt   DateTime @onCreate(now())

  @@unique([capturedFor, path])
}

// ---------------------------------------------------------------------------
// Repository Statistics
// Weekly/daily buckets are upserted; contributors and metadata are snapshots.
// ---------------------------------------------------------------------------

model GitHubRepoStatsSnapshot {
  id          String   @id @onCreate(uuid(7))
  capturedFor DateTime
  stars       Int      @default(0)
  forks       Int      @default(0)
  watchers    Int      @default(0)
  openIssues  Int      @default(0)
  language    String?
  license     String?
  topics      String?
  createdAt   DateTime @onCreate(now())

  @@unique([capturedFor])
}

model GitHubCommitActivityWeek {
  id        String   @id @onCreate(uuid(7))
  weekStart DateTime
  total     Int      @default(0)
  daysJson  String
  createdAt DateTime @onCreate(now())

  @@unique([weekStart])
}

model GitHubContributorSnapshot {
  id            String   @id @onCreate(uuid(7))
  capturedFor   DateTime
  login         String
  contributions Int      @default(0)
  createdAt     DateTime @onCreate(now())

  @@unique([capturedFor, login])
}

model GitHubCodeFrequencyWeek {
  id        String   @id @onCreate(uuid(7))
  weekStart DateTime
  additions Int      @default(0)
  deletions Int      @default(0)
  createdAt DateTime @onCreate(now())

  @@unique([weekStart])
}

model GitHubParticipationWeek {
  id         String   @id @onCreate(uuid(7))
  weekStart  DateTime
  allCount   Int      @default(0)
  ownerCount Int      @default(0)
  createdAt  DateTime @onCreate(now())

  @@unique([weekStart])
}

model GitHubPunchCardSlot {
  id        String   @id @onCreate(uuid(7))
  weekday   Int
  hour      Int
  count     Int      @default(0)
  createdAt DateTime @onCreate(now())

  @@unique([weekday, hour])
}

// ---------------------------------------------------------------------------
// Website Analytics (anonymous daily aggregates, no identifiers)
// ---------------------------------------------------------------------------

model WebsitePageViewDaily {
  id           String   @id @onCreate(uuid(7))
  day          DateTime
  path         String
  referrerHost String   @default("")
  countryCode  String   @default("XX")
  deviceType   String   @default("unknown")
  os           String   @default("unknown")
  count        Int      @default(1)
  createdAt    DateTime @onCreate(now())
  updatedAt    DateTime @onCreate(now()) @onUpdate(now())

  @@unique([day, path, referrerHost, countryCode, deviceType, os])
  @@index([day])
  @@index([path])
}

model WebsiteDownloadRequestDaily {
  id           String   @id @onCreate(uuid(7))
  day          DateTime
  assetId      String   @default("")
  releaseTag   String   @default("")
  channel      String   @default("")
  platform     String   @default("")
  arch         String   @default("")
  countryCode  String   @default("XX")
  referrerHost String   @default("")
  count        Int      @default(1)
  createdAt    DateTime @onCreate(now())
  updatedAt    DateTime @onCreate(now()) @onUpdate(now())

  @@unique([day, assetId, releaseTag, channel, platform, arch, countryCode, referrerHost])
  @@index([day])
  @@index([releaseTag])
}

// ---------------------------------------------------------------------------
// Analytics Sync Status
// ---------------------------------------------------------------------------

enum AnalyticsSyncStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
  PENDING
  EMPTY
  UNSUPPORTED
}

enum AnalyticsSource {
  TRAFFIC_VIEWS
  TRAFFIC_CLONES
  TRAFFIC_REFERRERS
  TRAFFIC_PATHS
  RELEASES
  REPO_METADATA
  COMMIT_ACTIVITY
  CONTRIBUTORS
  CODE_FREQUENCY
  PARTICIPATION
  PUNCH_CARD
}

model AnalyticsSyncRun {
  id           String              @id @onCreate(uuid(7))
  source       AnalyticsSource
  status       AnalyticsSyncStatus
  startedAt    DateTime            @onCreate(now())
  completedAt  DateTime?
  httpStatus   Int?
  itemCount    Int                 @default(0)
  errorCode    String?
  errorMessage String?

  @@index([source, startedAt])
  @@index([status])
}

model AnalyticsSourceStatus {
  id               String              @id @onCreate(uuid(7))
  source           AnalyticsSource     @unique
  status           AnalyticsSyncStatus
  lastSuccessAt    DateTime?
  lastFailureAt    DateTime?
  lastHttpStatus   Int?
  lastErrorCode    String?
  lastErrorMessage String?
  updatedAt        DateTime            @onCreate(now()) @onUpdate(now())
}

model DownloadSyncLog {
  id                   String             @id @onCreate(uuid(7))
  status               DownloadSyncStatus
  startedAt            DateTime           @onCreate(now())
  completedAt          DateTime?
  syncedAssetsCount    Int                @default(0)
  totalGitHubDownloads Int                @default(0)
  errorMessage         String?

  @@index([startedAt])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Advertising & Sponsoring System
// ---------------------------------------------------------------------------

enum AdvertiserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
}

enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
}

enum AdCampaignStatus {
  DRAFT
  PENDING_REVIEW
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  REJECTED
}

enum AdPlacementType {
  HOMEPAGE
  DOWNLOAD_PAGE
  PUBLIC_PAGES
}

enum AdFormat {
  BANNER
  SPONSOR_CARD
  LOGO_LINK
  CUSTOM
}

// Advertiser (Werbepartner - veraltet, durch Partner ersetzt)
model Advertiser {
  id          String           @id @onCreate(uuid(7))
  companyName String
  contactName String
  email       String
  websiteUrl  String?
  description String?
  logoUrl     String?
  status      AdvertiserStatus @default(ACTIVE)
  createdAt   DateTime         @onCreate(now())
  updatedAt   DateTime         @onCreate(now()) @onUpdate(now())

  @@index([status])
  @@index([email])
}

// ---------------------------------------------------------------------------
// Partner & Sponsoren Portal
// ---------------------------------------------------------------------------

enum PartnerStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum PartnerRelationshipType {
  OFFICIAL_PARTNER
  TECHNICAL_PARTNER
  SPONSOR
  MEDIA_PARTNER
  STRATEGIC_PARTNER
}

enum PartnerRelationshipStatus {
  ACTIVE
  ENDED
  PAUSED
}

// Partner (Unternehmen)
model Partner {
  id          String     @id @onCreate(uuid(7))
  companyName String
  description String?
  websiteUrl  String?
  logoUrl     String?
  isFeatured Boolean    @default(false)
  status      PartnerStatus @default(ACTIVE)
  createdAt   DateTime   @onCreate(now())
  updatedAt   DateTime   @onCreate(now()) @onUpdate(now())

  relationships PartnerRelationship[]
  history       PartnerHistory[]

  @@index([status])
  @@index([isFeatured])
}

// PartnerRelationship (Partnerschaftsverhältnis)
model PartnerRelationship {
  id         String                  @id @onCreate(uuid(7))
  partnerId  String
  type       PartnerRelationshipType
  startDate  DateTime
  endDate    DateTime?
  status     PartnerRelationshipStatus @default(ACTIVE)
  isPublic   Boolean                 @default(false)
  createdAt  DateTime                @onCreate(now())
  updatedAt  DateTime                @onCreate(now()) @onUpdate(now())

  partner    Partner                 @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  history    PartnerHistory[]

  @@index([partnerId])
  @@index([type])
  @@index([status])
  @@index([isPublic])
  @@index([startDate])
  @@index([endDate])
}

// PartnerHistory (Historie der Änderungen)
model PartnerHistory {
  id          String   @id @onCreate(uuid(7))
  partnerId   String
  relationshipId String?
  action      String
  details     String?
  performedBy String?
  createdAt   DateTime @onCreate(now())

  partner       Partner               @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  relationship PartnerRelationship?   @relation(fields: [relationshipId], references: [id], onDelete: SetNull)

  @@index([partnerId])
  @@index([relationshipId])
  @@index([createdAt])
}

// Advertising Application (Bewerbungen)
model AdvertisingApplication {
  id                 String           @id @onCreate(uuid(7))
  companyName        String
  contactName        String
  email              String
  websiteUrl         String?
  phone              String?
  adFormat           AdFormat
  placement          AdPlacementType
  desiredStartDate   DateTime?
  desiredEndDate     DateTime?
  description        String
  desiredBudget      String?
  customMessage      String?
  status             ApplicationStatus @default(PENDING)
  rejectionReason    String?
  internalNotes      String?
  reviewedById       String?
  reviewedAt         DateTime?
  createdAt          DateTime         @onCreate(now())
  updatedAt          DateTime         @onCreate(now()) @onUpdate(now())

  reviewedBy          User?            @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([email])
  @@index([createdAt])
}

// Ad Campaign (Kampagnen)
model AdCampaign {
  id            String          @id @onCreate(uuid(7))
  partnerId     String?
  advertiserId  String?
  name          String
  description   String?
  placement     AdPlacementType
  format        AdFormat
  startDate     DateTime
  endDate       DateTime
  targetUrl     String
  status        AdCampaignStatus @default(DRAFT)
  internalNotes String?
  createdAt     DateTime        @onCreate(now())
  updatedAt     DateTime        @onCreate(now()) @onUpdate(now())

  partner       Partner?         @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  advertiser    Advertiser?     @relation(fields: [advertiserId], references: [id], onDelete: SetNull)
  creatives     AdCreative[]
  impressions   AdImpression[]
  clicks        AdClick[]

  @@index([partnerId])
  @@index([advertiserId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@index([placement])
}

// Ad Creative (Werbemittel)
model AdCreative {
  id          String   @id @onCreate(uuid(7))
  campaignId  String
  imageUrl    String
  altText     String?
  width       Int
  height      Int
  fileSize    Int
  contentType String
  createdAt   DateTime @onCreate(now())

  campaign    AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

// Ad Impression (Impressionen)
model AdImpression {
  id          String   @id @onCreate(uuid(7))
  campaignId  String
  placement   AdPlacementType
  day         DateTime
  count       Int      @default(1)
  createdAt   DateTime @onCreate(now())
  updatedAt   DateTime @onCreate(now()) @onUpdate(now())

  campaign    AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, placement, day])
  @@index([day])
  @@index([placement])
}

// Ad Click (Klicks)
model AdClick {
  id          String   @id @onCreate(uuid(7))
  campaignId  String
  placement   AdPlacementType
  day         DateTime
  count       Int      @default(1)
  createdAt   DateTime @onCreate(now())
  updatedAt   DateTime @onCreate(now()) @onUpdate(now())

  campaign    AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, placement, day])
  @@index([day])
  @@index([placement])
}

// ---------------------------------------------------------------------------
// Custom Links Management
// ---------------------------------------------------------------------------

enum CustomLinkPosition {
  MAIN_NAVIGATION
  FOOTER
}

enum CustomLinkType {
  INTERNAL
  EXTERNAL
}

model CustomLink {
  id          String             @id @onCreate(uuid(7))
  position    CustomLinkPosition
  sortOrder   Int                @default(0)
  isActive    Boolean            @default(true)
  url         String
  type        CustomLinkType
  openInNewTab Boolean            @default(false)
  iconName    String?
  createdAt   DateTime           @onCreate(now())
  updatedAt   DateTime           @onCreate(now()) @onUpdate(now())
  createdBy   String?
  updatedBy   String?

  labels      CustomLinkLabel[]

  @@index([position])
  @@index([isActive])
  @@index([sortOrder])
  @@index([createdAt])
}

model CustomLinkLabel {
  id          String   @id @onCreate(uuid(7))
  linkId      String
  locale      String
  label       String
  createdAt   DateTime @onCreate(now())
  updatedAt   DateTime @onCreate(now()) @onUpdate(now())

  link        CustomLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@unique([linkId, locale])
  @@index([linkId])
  @@index([locale])
}

