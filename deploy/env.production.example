# Production environment for the Docker Compose stack.
#
#   cp deploy/env.production.example deploy/env.production
#   chmod 600 deploy/env.production
#   # replace every CHANGE_ME value, then:
#   docker compose --env-file deploy/env.production up -d --build
#
# deploy/env.production is git-ignored and must never be committed. The
# mandatory marker below proves the file was passed with --env-file; the
# development `.env` does not contain it.

WEBRADIO_STACK_ENV=production

# --- Public origin -----------------------------------------------------------
# Full origin, no trailing slash. Must be HTTPS in production.
SITE_ADDRESS=https://CHANGE_ME.example
NEXTAUTH_URL=https://CHANGE_ME.example
# Used for canonical URLs, Open Graph and sitemap.
NEXT_PUBLIC_SITE_URL=https://CHANGE_ME.example
# ACME contact address (certificate expiry notices).
ACME_EMAIL=CHANGE_ME@example.com

# Test hosts only (isolated VM, internal CA): CADDYFILE + SITE_HOST in
# deploy/env.test, see the deployment guide. Leave unset for production.

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=webradio
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
POSTGRES_DB=webradio
TZ=UTC

# Tuning (defaults in compose.yaml are the documented baseline):
# PG_SHARED_BUFFERS=256MB
# PG_EFFECTIVE_CACHE_SIZE=768MB
# PG_MAX_CONNECTIONS=50

# --- Application secrets -----------------------------------------------------
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NEXTAUTH_SECRET=CHANGE_ME_32_BYTES_BASE64URL
# Enables POST /api/cron/analytics. Without it the endpoint answers 503.
CRON_SECRET=CHANGE_ME_32_BYTES_BASE64URL

# --- Optional integrations ---------------------------------------------------
# TRUST_PROXY=1
# GITHUB_APP_ID=
# GITHUB_CLIENT_ID=
# GITHUB_INSTALLATION_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_WEBHOOK_SECRET=
