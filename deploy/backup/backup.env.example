# Environment for deploy/backup/pg-backup.sh, config-backup.sh and restore-drill.sh.
# Install as /etc/webradio/backup.env (0600 root:root).
#
# The encryption key file is separate and must be 0600:
#   openssl rand -base64 32 | tr -d '\n' > /etc/webradio/backup.key
#   chmod 600 /etc/webradio/backup.key
# Losing that key makes every existing backup unreadable. Store a copy in a
# password manager or offline safe, never next to the backups.

BACKUP_MODE=docker
BACKUP_DIR=/var/backups/webradio
BACKUP_KEEP=14
BACKUP_KEY_FILE=/etc/webradio/backup.key

# Configuration archive (compose.yaml, Caddyfiles, units, scripts, docs).
# Never contains .env/.key/.pem files: the script aborts if one is matched.
CONFIG_BACKUP=1
REPO_DIR=/opt/webradio
# Additional host paths (space separated; globs allowed):
# CONFIG_EXTRA_PATHS="/etc/caddy/Caddyfile /etc/systemd/system/webradio-*.service /etc/systemd/system/webradio-*.timer"

# docker mode
COMPOSE_FILE=/opt/webradio/compose.yaml
COMPOSE_ENV_FILE=/opt/webradio/deploy/env.production
PGUSER=webradio
PGDATABASE=webradio

# native mode (uncomment and remove the docker block)
# BACKUP_MODE=native
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=webradio_backup
# PGDATABASE=webradio
# PGPASSWORD=CHANGE_ME

# Offsite copies are configured separately in /etc/webradio/offsite.env.
