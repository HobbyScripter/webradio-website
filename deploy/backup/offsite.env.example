# Environment for deploy/backup/offsite-sync.sh.
# Install as /etc/webradio/offsite.env (0600 root:root).
#
# The script only ever copies encrypted archives (*.enc) and their checksum
# files. Keys, plaintext dumps, env files and logs never leave the host.

# Empty = not configured; the unit then logs "offsite not configured" and exits 0.
OFFSITE_TARGET=

# auto: "host:/path" -> rsync, absolute path -> local directory.
# local: second disk, mounted NAS or a directory used for the local simulation.
# rsync: user@host:/path over SSH (key-based, BatchMode).
OFFSITE_MODE=auto

# Archives kept at the target (local mode prunes; rsync mode leaves retention
# to the remote side).
OFFSITE_KEEP=7

# Source directory (normally from backup.env; repeated here for clarity).
BACKUP_DIR=/var/backups/webradio

# Optional SSH identity for rsync mode.
# OFFSITE_SSH_KEY=/root/.ssh/webradio_offsite
