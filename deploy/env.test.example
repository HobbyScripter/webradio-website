# Compose environment for an isolated test host (no public DNS).
#
#   cp deploy/env.test.example deploy/env.test      # 0600, set the passwords
#   docker compose --env-file deploy/env.test up -d --build
#
# The stack publishes 8080/8443 instead of 80/443 and Caddy uses its internal
# CA. NEXTAUTH_URL must include the published HTTPS port.

WEBRADIO_STACK_ENV=test

SITE_ADDRESS=https://localhost
SITE_HOST=localhost
NEXTAUTH_URL=https://localhost:8443
NEXT_PUBLIC_SITE_URL=https://localhost:8443
ACME_EMAIL=

CADDYFILE=./deploy/Caddyfile.internal
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443

POSTGRES_USER=webradio
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
POSTGRES_DB=webradio_infra14_test
TZ=UTC

NEXTAUTH_SECRET=CHANGE_ME_32_BYTES_BASE64URL
CRON_SECRET=CHANGE_ME_32_BYTES_BASE64URL
TRUST_PROXY=1
