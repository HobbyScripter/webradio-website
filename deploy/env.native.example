# Environment for the native operating form (systemd + host PostgreSQL).
#
# Installed as /etc/webradio/app.env (0600, webradio:webradio) by
#   sudo deploy/install/install-production.sh --apply --mode native
#
# Replace every CHANGE_ME value. NEXTAUTH_SECRET/CRON_SECRET are generated by
# the installer when the file is first created; they are never printed.

NODE_ENV=production
PORT=3010
# Loopback only: Caddy is the sole public listener and sets X-Forwarded-*.
HOSTNAME=127.0.0.1

DATABASE_PROVIDER=self-hosted
DATABASE_URL=postgresql://webradio_app:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/webradio
# Optional allowlist for additional database hosts (comma separated).
DATABASE_ALLOWED_HOSTS=

NEXTAUTH_URL=https://CHANGE_ME.example
NEXT_PUBLIC_SITE_URL=https://CHANGE_ME.example
NEXTAUTH_SECRET=CHANGE_ME_32_BYTES
CRON_SECRET=CHANGE_ME_32_BYTES
TRUST_PROXY=1

# Optional GitHub integration
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
