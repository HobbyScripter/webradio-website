# Environment for deploy/monitoring/health-report.sh.
# Install as /etc/webradio/monitoring.env (0600 root:root).

# docker (compose stack) or native (systemd + host PostgreSQL)
MODE=native

# Application liveness endpoint (loopback; never the public origin)
HEALTH_URL=http://127.0.0.1:3010/api/health

# Readiness endpoint with database access (SELECT 1). Defaults to HEALTH_URL
# with /api/health replaced by /api/ready. Set it explicitly when HEALTH_URL
# points at another host or path.
# Note: if HEALTH_URL goes through Caddy, a failed readiness check makes Caddy
# answer 503 for every path (including /api/health). Use the loopback app
# address when a process-only liveness signal is required.
# READINESS_URL=http://127.0.0.1:3010/api/ready

# Optional HTTPS check (certificate expiry). Include the port when it is not 443.
SITE_URL=https://webradio.example.com
# Optional CA bundle for an internal CA:
# CA_FILE=/etc/ssl/certs/webradio-internal-ca.pem

# Authenticated database check for native mode (optional, uses libpq env):
# CHECK_DB_URL=postgresql://webradio_monitor@127.0.0.1:5432/webradio

# Units that must be active (space separated; quote the value)
MONITOR_UNITS="webradio-app.service postgresql.service caddy.service"

# docker mode: container health (compose service names)
# CHECK_CONTAINERS=webradio postgres caddy

# auto: native -> caddy.service, docker -> internal /healthz probe; off disables
CADDY_CHECK=auto

BACKUP_DIR=/var/backups/webradio
BACKUP_MAX_AGE_HOURS=26
CONFIG_BACKUP_MAX_AGE_HOURS=48
CRON_LOG=/var/log/webradio/cron.log
MONITOR_LOG=/var/log/webradio/health.jsonl

DISK_WARN=85
DISK_FAIL=95
LOAD_WARN_FACTOR=1.5
CPU_WARN=85

# Verify 0600 on backup.key and the /etc/webradio env files
CHECK_CONFIG_PERMS=1

# Compose paths (docker mode)
# COMPOSE_FILE=/opt/webradio/compose.yaml
# COMPOSE_ENV_FILE=/opt/webradio/deploy/env.production

# Optional alert target for FAIL results
# ALERT_WEBHOOK_URL=https://example.invalid/webhook
