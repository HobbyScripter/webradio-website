{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "functions": {
    "src/app/api/schedules/analytics/route.ts": {
      "experimentalTriggers": [
        {
          "type": "schedule/v1beta"
        }
      ]
    },
    "src/app/api/schedules/translations/route.ts": {
      "experimentalTriggers": [
        {
          "type": "schedule/v1beta"
        }
      ]
    }
  },
  "schedules": {
    "analytics-traffic": {
      "schedule": "15 3 * * *",
      "timezone": "UTC",
      "function": "api/schedules/analytics"
    },
    "analytics-repo-stats": {
      "schedule": "45 3 * * *",
      "timezone": "UTC",
      "function": "api/schedules/analytics"
    },
    "analytics-releases": {
      "schedule": "15 4 * * *",
      "timezone": "UTC",
      "function": "api/schedules/analytics"
    },
    "analytics-retention": {
      "schedule": "45 4 * * *",
      "timezone": "UTC",
      "function": "api/schedules/analytics"
    },
    "translations-worker": {
      "schedule": "30 5 * * *",
      "timezone": "UTC",
      "function": "api/schedules/translations"
    }
  }
}
