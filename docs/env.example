# WebRadio Website - Environment Variables
# Copy this file to .env and fill in the actual values.
# NEVER commit .env to Git.
#
# Generate secrets with:
#   openssl rand -base64 32
#
# See docs/SECURITY.md for the complete security architecture.

# ==============================================================================
# DATABASE (Required)
# ==============================================================================
# PostgreSQL connection string.
# For local development, use a local or cloud-hosted PostgreSQL instance.
# Options: Neon, Supabase, Railway, local Docker.
#
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://username:password@localhost:5432/webradio_dev?sslmode=require"

# ==============================================================================
# NEXTAUTH (Required)
# ==============================================================================
# Secret key for signing session tokens. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# The canonical URL of the application (no trailing slash).
# Development: http://localhost:3000
# Production:  https://your-domain.com
NEXTAUTH_URL="http://localhost:3000"

# ==============================================================================
# OBJECT STORAGE (Required for file uploads — Phase 6)
# ==============================================================================
# Used for storing plugin/theme package files and screenshots.
# Options: AWS S3, Cloudflare R2, Backblaze B2, DigitalOcean Spaces.
# Leave empty until Phase 6.
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET=""
STORAGE_REGION=""

# ==============================================================================
# EMAIL SERVICE (Required for transactional emails — Phase 3)
# ==============================================================================
# Used for email verification, password reset, and notifications.
# Options: SendGrid, AWS SES, Mailgun, Postmark.
# Leave empty until Phase 3.
EMAIL_FROM="noreply@webradio.example.com"
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""

# ==============================================================================
# GITHUB INTEGRATION (Optional — Phase 4)
# ==============================================================================
# GitHub OAuth for developer login (optional).
# Create an OAuth App at: https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Secret for validating GitHub webhook signatures.
# Generate with: openssl rand -base64 32
GITHUB_WEBHOOK_SECRET=""

# ==============================================================================
# APPLICATION
# ==============================================================================
NODE_ENV="development"
